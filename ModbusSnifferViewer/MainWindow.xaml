<Window x:Class="ModbusSnifferViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modbus Sniffer Log Viewer" Height="720" Width="1200"
        MinHeight="480" MinWidth="800" Background="#F4F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Background" Value="#FFF0F0" />
                    <Setter Property="Foreground" Value="#9B1C1C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Modbus Sniffer Log Viewer" FontSize="24" FontWeight="SemiBold" Foreground="#1F2933" VerticalAlignment="Center" />
                <TextBlock x:Name="FileText" Grid.Column="1" Margin="20,0,12,0" VerticalAlignment="Center" Foreground="#52606D" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Content="Open log..." Padding="14,7" Click="OpenLog_Click" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="FilterTextBox" Width="280" Padding="6" TextChanged="FilterTextBox_TextChanged" />
                <CheckBox x:Name="ErrorsOnlyCheckBox" Content="Errors only" Margin="16,0,0,0" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged" />
                <TextBlock x:Name="CountText" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#52606D" />
            </StackPanel>
            <GroupBox Header="Complete log" Margin="0,0,0,10" Padding="8">
                <TextBlock x:Name="StatisticsText" TextWrapping="Wrap" Foreground="#334E68" />
            </GroupBox>
        </StackPanel>
        <GroupBox DockPanel.Dock="Bottom" Header="Selected record" Margin="0,12,0,0" Padding="8">
            <TextBox x:Name="DetailsTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="80" Background="White" />
        </GroupBox>
        <DataGrid x:Name="LogGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" SelectionChanged="LogGrid_SelectionChanged" Background="White" BorderBrush="#D9E2EC" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" Width="175" />
                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="260" />
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="75" />
                <DataGridTextColumn Header="Function" Binding="{Binding Function}" Width="80" />
                <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="65" />
                <DataGridTextColumn Header="USB transmissions" Binding="{Binding UsbTransmissions}" Width="125" />
                <DataGridTextColumn Header="Response ms" Binding="{Binding ResponseTimeMilliseconds, StringFormat={}{0:F1}}" Width="95" />
                <DataGridTextColumn Header="Max gap ms" Binding="{Binding MaximumGapMilliseconds, StringFormat={}{0:F3}}" Width="95" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
