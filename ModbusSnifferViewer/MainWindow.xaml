<Window x:Class="ModbusSnifferViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modbus Sniffer Log Viewer" Height="720" Width="1320"
        MinHeight="480" MinWidth="800" Background="#F4F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <!-- SuspectGap first so an error row (red) still wins when a frame is both. -->
                <DataTrigger Binding="{Binding SuspectGap}" Value="True">
                    <Setter Property="Background" Value="#FFF6D8" />
                    <Setter Property="Foreground" Value="#7A4F01" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Background" Value="#FFF0F0" />
                    <Setter Property="Foreground" Value="#9B1C1C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Modbus Sniffer Log Viewer" FontSize="24" FontWeight="SemiBold" Foreground="#1F2933" VerticalAlignment="Center" />
                <TextBlock x:Name="FileText" Grid.Column="1" Margin="20,0,12,0" VerticalAlignment="Center" Foreground="#52606D" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Content="Open log..." Padding="14,7" Click="OpenLog_Click" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="SearchTextBox" Width="280" Padding="6" KeyDown="SearchTextBox_KeyDown" />
                <Button Content="Find next" Margin="8,0,0,0" Padding="12,6" Click="FindNext_Click" />
                <CheckBox x:Name="ErrorsOnlyCheckBox" Content="Errors only" Margin="16,0,0,0" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged" />
                <TextBlock x:Name="CountText" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#52606D" />
            </StackPanel>
            <GroupBox Header="Complete log" Margin="0,0,0,10" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Overview" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,0,0,4" />
                        <TextBlock x:Name="OverviewText" TextWrapping="Wrap" Foreground="#334E68" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Traffic" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,0,0,4" />
                        <TextBlock x:Name="TrafficText" TextWrapping="Wrap" Foreground="#334E68" FontFamily="Consolas" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Errors" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,0,0,4" />
                        <TextBlock x:Name="ErrorsText" TextWrapping="Wrap" Foreground="#334E68" FontFamily="Consolas" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Latency &amp; timing" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,0,0,4" />
                        <TextBlock x:Name="TimingText" TextWrapping="Wrap" Foreground="#334E68" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </StackPanel>
        <GroupBox DockPanel.Dock="Bottom" Header="Selected record" Margin="0,12,0,0" Padding="8">
            <TextBox x:Name="DetailsTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="80" Background="White" />
        </GroupBox>
        <DataGrid x:Name="LogGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" SelectionChanged="LogGrid_SelectionChanged" Background="White" BorderBrush="#D9E2EC" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" Width="175" />
                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="205" />
                <DataGridTextColumn Header="Addr hex" Binding="{Binding Address}" Width="65" />
                <DataGridTextColumn Header="Addr dec" Binding="{Binding AddressDecimal}" Width="65" />
                <DataGridTextColumn Header="Function" Binding="{Binding Function}" Width="65" />
                <DataGridTextColumn Header="Function name" Binding="{Binding FunctionName}" Width="175" />
                <DataGridTextColumn Header="Recv len" Binding="{Binding Length}" Width="65" />
                <DataGridTextColumn Header="Req qty" Binding="{Binding RequestQuantity}" Width="60" />
                <DataGridTextColumn Header="Resp qty" Binding="{Binding ResponseQuantity}" Width="62" />
                <DataGridTextColumn Header="USB transmissions" Binding="{Binding UsbTransmissions}" Width="115" />
                <DataGridTextColumn Header="Response ms" Binding="{Binding ResponseTimeMilliseconds, StringFormat={}{0:F1}}" Width="90" />
                <DataGridTextColumn Header="Max gap ms" Binding="{Binding MaximumGapMilliseconds, StringFormat={}{0:F3}}" Width="90">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <!-- Highlight the gap cell even on red error rows, so the SUSPECT_GAP signal is never hidden. -->
                                <DataTrigger Binding="{Binding SuspectGap}" Value="True">
                                    <Setter Property="Background" Value="#F6C445" />
                                    <Setter Property="Foreground" Value="#3B2F00" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
